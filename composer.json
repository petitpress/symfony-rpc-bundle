{
    "name": "seven/symfony-rpc-bundle",
    "description": "This Symfony bundle provide easy way to create XMLRPC server",
    "keywords": ["Symfony", "XMLRPC", "Server", "XML-RPC", "RPC", "Bundle"],
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Sergey Kolodyazhnyy",
            "email": "sergey.kolodyazhnyy@gmail.com"
        }
    ],
    "require": {
        "php": "^7.2.5 || ^8.0",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "psr/log": "^1.0 || ^2.0 || ^3.0",
        "symfony/config": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "symfony/framework-bundle": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "symfony/http-foundation": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "symfony/yaml": "^5.4 || ^6.0 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": { "Seven\\RpcBundle\\": "" },
        "exclude-from-classmap": ["/Tests/", "/Resources/"]
    },
    "autoload-dev": {
        "psr-4": { "Seven\\RpcBundle\\Tests\\": "Tests/" }
    }
}
